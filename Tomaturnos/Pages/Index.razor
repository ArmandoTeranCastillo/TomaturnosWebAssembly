@page "/"
@inject NavigationManager Navigation

<PageTitle>Tomaturnos</PageTitle>

@code {
    private bool _isNavigated;

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender || _isNavigated) return;
        Navigation.NavigateTo("/SelectorMunicipio", true);
        _isNavigated = true; // Para asegurarte de que la navegación solo se realiza una vez
    }
}
