@using TomaTurnos.Data.Dependencies.Services
@inherits LayoutComponentBase
@inject MunicipioState MunicipioState

<PageTitle>TomaTurnos</PageTitle>

<div class="page">
    <main>
        <div class="px-5 container-images">
            <span class="modulo-titulo">@MunicipioState.Municipio</span>
            <img class="image image-secretaria" src="images/Secretaria.png" alt="Secretaría"/>
            <img class="image image-chihuahua" src="images/LogoChihuahua.png" alt="Chihuahua"/>
        </div>
        <div>
            @Body
        </div>
    </main>
</div>